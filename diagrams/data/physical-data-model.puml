@startuml
hide circle
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName Helvetica
skinparam DefaultFontSize 12
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

entity "User" as User {
  id : uuid <<PK>>
  --
  login : varchar(8) <<unique>>
  passwordHash : varchar(60)
  role : ENUM('ADMIN','PLAYER')
}

entity "Labyrinth" as Labyrinth {
  id : uuid <<PK>>
  --
  createdById : uuid <<FK>>
  name : varchar(100)
  width : smallint
  height : smallint
  theme : ENUM('WINTER','SUMMER','AUTUMN','SPRING')
  generationAlgorithm : ENUM('PRIM','KRUSKAL')
  entryMode : ENUM('AUTO','MANUAL')
  grid : jsonb
}

User ||--o{ Labyrinth

@enduml
