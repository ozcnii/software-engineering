@startuml
hide circle
skinparam backgroundColor #FFFFFF
skinparam DefaultFontName Helvetica
skinparam DefaultFontSize 12
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

entity "User" as User {
  id
  --
  login
  passwordHash
  role
}

entity "Labyrinth" as Labyrinth {
  id
  --
  createdById (FK)
  name
  width
  height
  theme
  generationAlgorithm
  entryMode
  grid
}

User ||--o{ Labyrinth

@enduml
