@startuml
title Диаграмма компонентов системы

skinparam backgroundColor #FFFFFF
skinparam DefaultFontName Helvetica
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
}
skinparam ArrowColor #000000
skinparam ArrowFontSize 11

left to right direction

component "React/Vite frontend" <<executable>> as Frontend
component "App.tsx" <<source>> as App
component "router.tsx" <<source>> as Router
component "AuthScreen.tsx" <<source>> as AuthScreen
component "LoginForm.tsx" <<source>> as LoginForm
component "RegisterForm.tsx" <<source>> as RegisterForm
component "AdminLayout.tsx" <<source>> as AdminLayout
component "AdminLabyrinthList.tsx" <<source>> as AdminList
component "AdminCreateWizard.tsx" <<source>> as AdminCreate
component "AdminMazeEditor.tsx" <<source>> as AdminEditor
component "CreateEditorStep.tsx" <<source>> as CreateEditorStep
component "mazeEditorRules.ts" <<source>> as MazeEditorRules
component "PlayerLayout.tsx" <<source>> as PlayerLayout
component "PlayerLabyrinthList.tsx" <<source>> as PlayerList
component "MazeGrid.tsx" <<source>> as MazeGrid
component "AutoSolvePanel.tsx" <<source>> as AutoSolvePanel
component "HelpPage.tsx" <<source>> as HelpPage
component "DevelopersModal" <<source>> as DevelopersModal
component "client.ts" <<source>> as ClientApi
component "authApi.ts" <<source>> as AuthApi
component "labyrinthsApi.ts" <<source>> as LabyrinthsApi
component "@labyrinth/shared types" <<library>> as SharedTypes

component "NestJS backend API" <<executable>> as BackendApi
component "main.ts" <<source>> as MainTs
component "app.module.ts" <<source>> as AppModule
component "auth.module.ts" <<source>> as AuthModule
component "users.module.ts" <<source>> as UsersModule
component "labyrinths.module.ts" <<source>> as LabyrinthsModule
component "labyrinths.controller.ts" <<source>> as LabyrinthsController
component "labyrinths.service.ts" <<source>> as LabyrinthsService
component "labyrinth-game.ts" <<source>> as LabyrinthGame
component "maze.ts" <<source>> as Maze
component "solution-path.ts" <<source>> as SolutionPath
component "prim.generator.ts" <<source>> as PrimGenerator
component "kruskal.generator.ts" <<source>> as KruskalGenerator
component "bfs.solver.ts" <<source>> as BfsSolver
component "right-hand.solver.ts" <<source>> as RightHandSolver
component "grid-validation.ts" <<source>> as GridValidation
component "Prisma Client" <<library>> as PrismaClient

Frontend ..> App
App ..> Router
Router ..> AuthScreen
AuthScreen ..> LoginForm
AuthScreen ..> RegisterForm
Router ..> AdminLayout
AdminLayout ..> AdminList
AdminLayout ..> AdminCreate
AdminLayout ..> HelpPage
AdminLayout ..> DevelopersModal
AdminCreate ..> AdminEditor
AdminCreate ..> CreateEditorStep
AdminCreate ..> MazeEditorRules
CreateEditorStep ..> AdminEditor
AdminEditor ..> MazeEditorRules
Router ..> PlayerLayout
PlayerLayout ..> PlayerList
PlayerLayout ..> MazeGrid
PlayerLayout ..> AutoSolvePanel
PlayerLayout ..> HelpPage
PlayerLayout ..> DevelopersModal

LoginForm ..> AuthApi
RegisterForm ..> AuthApi
AdminList ..> LabyrinthsApi
AdminCreate ..> LabyrinthsApi
PlayerLayout ..> LabyrinthsApi
AuthApi ..> ClientApi
LabyrinthsApi ..> ClientApi
AuthApi ..> SharedTypes
LabyrinthsApi ..> SharedTypes
ClientApi ..> BackendApi

BackendApi ..> MainTs
MainTs ..> AppModule
AppModule ..> AuthModule
AppModule ..> UsersModule
AppModule ..> LabyrinthsModule
AuthModule ..> UsersModule
LabyrinthsModule ..> UsersModule
LabyrinthsModule ..> LabyrinthsController
LabyrinthsModule ..> LabyrinthsService
LabyrinthsController ..> LabyrinthsService
LabyrinthsService ..> LabyrinthGame
LabyrinthGame ..> Maze
LabyrinthGame ..> SolutionPath
LabyrinthGame ..> PrimGenerator
LabyrinthGame ..> KruskalGenerator
LabyrinthGame ..> BfsSolver
LabyrinthGame ..> RightHandSolver
LabyrinthsService ..> GridValidation
UsersModule ..> PrismaClient
LabyrinthsService ..> PrismaClient
LabyrinthGame ..> SharedTypes

@enduml
