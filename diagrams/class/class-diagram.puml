@startuml
title Диаграмма классов системы

skinparam backgroundColor #FFFFFF
skinparam DefaultFontName Helvetica
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
  AttributeIconSize 0
}
skinparam ArrowColor #000000
skinparam ArrowFontSize 11
hide circle

left to right direction

class User {
  -id
  -login
  -role
}

class LabyrinthsController {
  +list()
  +generate()
  +create()
  +checkName()
  +detail()
  +delete()
  +solve()
}

class LabyrinthsService {
  +list()
  +generate()
  +create()
  +checkName()
  +detail()
  +remove()
  +solve()
}

class LabyrinthGame {
  -id
  -name
  -width
  -height
  -theme
  -generationAlgorithm
  -entryMode
  -maze
  +generate()
  +solve()
}

class Maze {
  -width
  -height
  -cells
  +placeAutoEntryExit()
  +placeEntryExit()
  +requireEntryExit()
}

class Coordinate {
  -row
  -col
}

class SolutionPath {
  -algorithm
  -path
  +steps
  +toResponse()
}

class GridValidation {
  +validateOddSize()
  +validateEntryExitCoordinates()
  +validateGridForPersistence()
  +validateThickWallStructure()
  +allPassableCellsAreConnected()
  +hasPath()
}

class PrimGenerator {
  +generatePrimMaze()
}

class KruskalGenerator {
  +generateKruskalMaze()
}

class BfsSolver {
  +solveBfs()
}

class RightHandSolver {
  +solveRightHand()
}

User "1" -- "0..*" LabyrinthGame
LabyrinthsController ..> LabyrinthsService
LabyrinthsService ..> LabyrinthGame
LabyrinthsService ..> GridValidation
LabyrinthGame *-- Maze
Maze *-- Coordinate
SolutionPath *-- Coordinate
LabyrinthGame ..> SolutionPath
LabyrinthGame ..> PrimGenerator
LabyrinthGame ..> KruskalGenerator
LabyrinthGame ..> BfsSolver
LabyrinthGame ..> RightHandSolver
Maze ..> GridValidation

@enduml
