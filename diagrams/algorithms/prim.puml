@startuml prim
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #333333
skinparam ArrowColor #333333

title Схема алгоритма генерации лабиринта методом Прима

start
:Ввести ширину и высоту сетки;
:Создать сетку, заполненную стенами;
:Случайно выбрать стартовую\n"комнату" с нечётными координатами;
:Пометить стартовую клетку\nкак пройденную;
:Добавить фронтиры стартовой\nклетки в список фронтиров;
while (Список фронтиров не пуст?) is (да)
  :Случайно извлечь фронтир\nиз списка;
  if (Целевая клетка фронтира\nуже посещена?) then (да)
  else (нет)
    :Перевести стену фронтира\nв проход;
    :Пометить целевую клетку\nкак пройденную;
    :Добавить фронтиры целевой\nклетки в список фронтиров;
  endif
endwhile (нет)
:Вернуть готовую сетку лабиринта;
stop

@enduml
