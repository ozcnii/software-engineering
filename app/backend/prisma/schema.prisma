generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PLAYER
}

model User {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
}
