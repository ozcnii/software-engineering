@startuml
title Диаграмма состояний системы (общая часть)

skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
  ArrowColor #000000
  ArrowFontSize 11
  ArrowFontStyle italic
}
skinparam DefaultFontName Helvetica

[*] --> ЗапускПриложения

state "Запуск приложения" as ЗапускПриложения {
  ЗапускПриложения : entry / установить соединение с БД
  ЗапускПриложения : do / открыть главную форму
  ЗапускПриложения : exit / отобразить форму авторизации
}

state "Авторизация пользователя" as Авторизация {
  Авторизация : entry / отобразить форму авторизации
  Авторизация : do / ввести логин
  Авторизация : do / ввести пароль
  Авторизация : do / ввести подтверждение пароля (при регистрации)
  Авторизация : do / проверить корректность данных
  Авторизация : do / проверить наличие пользователя в БД
  Авторизация : exit / настроить интерфейс с учётом роли пользователя
}

state "Работа с приложением:\nАдминистратор" as РаботаАдмин
РаботаАдмин : include / Диаграмма состояний (Администратор)

state "Работа с приложением:\nИгрок" as РаботаИгрок
РаботаИгрок : include / Диаграмма состояний (Игрок)

state "Завершение работы\nс приложением" as Завершение {
  Завершение : entry / закрыть активные формы
  Завершение : entry / закрыть соединение с БД
  Завершение : exit / выход в ОС
}

ЗапускПриложения --> Авторизация : [соединение с БД установлено]
ЗапускПриложения --> Завершение : [соединение с БД\nне установлено]

Авторизация --> Авторизация : [введены некорректные данные]
Авторизация --> РаботаАдмин : [данные верны\nи роль = Администратор]
Авторизация --> РаботаИгрок : [данные верны\nи роль = Игрок]

РаботаАдмин --> Завершение : нажата кнопка "Выйти"
РаботаИгрок --> Завершение : нажата кнопка "Выйти"

Завершение --> [*]

@enduml
