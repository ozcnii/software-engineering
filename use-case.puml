@startuml

top to bottom direction

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
}
skinparam ArrowColor #000000
skinparam ArrowFontSize 11
skinparam ArrowFontStyle italic

' =====================
' АКТЁРЫ
' =====================
actor "Пользователь" as User
actor "Администратор" as Admin
actor "Игрок" as Player

Admin --|> User
Player --|> User

' =====================
' ВАРИАНТЫ ИСПОЛЬЗОВАНИЯ
' =====================

' --- Пользователь ---
usecase "Просмотреть сведения\nо системе" as UC_InfoSys
usecase "Просмотреть сведения\nо разработчике" as UC_InfoDev
usecase "Авторизоваться" as UC_Auth
usecase "Ввести логин" as UC_Login
usecase "Ввести пароль" as UC_Password
usecase "Зарегистрироваться" as UC_Register
usecase "Ввести подтверждение\nпароля" as UC_PasswordConfirm

' --- Общий для Админа и Игрока ---
usecase "Изменить тему\nоформления" as UC_Theme

' --- Администратор ---
usecase "Просмотреть список\nлабиринтов" as UC_ViewList
usecase "Создать лабиринт" as UC_Create
usecase "Ввести название\nлабиринта" as UC_Name
usecase "Ввести ширину\nлабиринта" as UC_Width
usecase "Ввести высоту\nлабиринта" as UC_Height
usecase "Выбрать алгоритм\nгенерации" as UC_GenAlgo
usecase "Расставить вход\nи выход" as UC_InOut
usecase "Выбрать способ\nрасстановки" as UC_InOutMode
usecase "Расставить\nавтоматически" as UC_InOutAuto
usecase "Расставить\nвручную" as UC_InOutManual
usecase "Задать вход" as UC_SetEntry
usecase "Задать выход" as UC_SetExit
usecase "Сохранить лабиринт" as UC_Save
usecase "Удалить лабиринт" as UC_Delete
usecase "Подтвердить\nудаление" as UC_DeleteConfirm

' --- Игрок ---
usecase "Выбрать лабиринт\nиз списка" as UC_Select
usecase "Пройти лабиринт" as UC_Play
usecase "Пройти вручную" as UC_Manual
usecase "Пройти автоматически" as UC_Auto
usecase "Выбрать алгоритм\nпоиска пути" as UC_PathAlgo
usecase "Настроить скорость\nперемещения" as UC_Speed
usecase "Найти путь\nв лабиринте" as UC_FindPath
usecase "Отобразить следы\nпрохождения" as UC_Trace

' =====================
' СВЯЗИ
' =====================

' Пользователь
User -- UC_InfoSys
User -- UC_InfoDev
User -- UC_Auth
User -- UC_Register

UC_Auth ..> UC_Login    : <<include>>
UC_Auth ..> UC_Password : <<include>>

UC_Register ..> UC_Login            : <<include>>
UC_Register ..> UC_Password         : <<include>>
UC_Register ..> UC_PasswordConfirm  : <<include>>

' Администратор
Admin -- UC_ViewList
Admin -- UC_Create
Admin -- UC_Save
Admin -- UC_Delete

UC_Delete ..> UC_ViewList      : <<extend>>
UC_Delete ..> UC_DeleteConfirm : <<include>>

UC_Create ..> UC_Name   : <<include>>
UC_Create ..> UC_Width  : <<include>>
UC_Create ..> UC_Height : <<include>>

UC_Theme   ..> UC_Create : <<extend>>
UC_GenAlgo ..> UC_Create : <<extend>>
UC_InOut   ..> UC_Create : <<extend>>

UC_InOut ..> UC_InOutMode        : <<include>>
UC_InOutAuto   ..> UC_InOutMode  : <<extend>>
UC_InOutManual ..> UC_InOutMode  : <<extend>>

UC_InOutManual ..> UC_SetEntry : <<include>>
UC_InOutManual ..> UC_SetExit  : <<include>>

' Игрок
Player -- UC_Select
Player -- UC_Play

UC_Theme ..> UC_Select : <<extend>>
UC_Theme ..> UC_Play   : <<extend>>

UC_Manual ..> UC_Play : <<extend>>
UC_Auto   ..> UC_Play : <<extend>>

UC_Auto ..> UC_PathAlgo : <<include>>
UC_Speed ..> UC_Auto    : <<extend>>
UC_Auto ..> UC_FindPath : <<include>>
UC_Auto ..> UC_Trace    : <<include>>

UC_Manual ..> UC_Trace : <<include>>

@enduml
