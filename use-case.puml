@startuml

left to right direction
skinparam usecase {
  BackgroundColor #FFFFCC
  BorderColor #CC0000
  ArrowColor #CC0000
  ActorBorderColor #CC0000
  ActorBackgroundColor #FFFFFF
}

actor "Пользователь" as User
actor "Администратор" as Admin
actor "Игрок" as Player

Admin -|> User
Player -|> User

' --- Общие для Пользователя ---
usecase "Просмотреть сведения о системе" as UC_InfoSys
usecase "Просмотреть сведения о разработчиках" as UC_InfoDev

usecase "Авторизоваться" as UC_Auth
usecase "Ввести логин" as UC_Login
usecase "Ввести пароль" as UC_Password

usecase "Зарегистрироваться" as UC_Register
usecase "Ввести подтверждение пароля" as UC_PasswordConfirm

' --- Общий для Админа и Игрока ---
usecase "Изменить тему оформления" as UC_Theme

' --- Администратор ---
usecase "Создать лабиринт" as UC_Create
usecase "Ввести название лабиринта" as UC_Name
usecase "Ввести ширину лабиринта" as UC_Width
usecase "Ввести высоту лабиринта" as UC_Height
usecase "Выбрать алгоритм генерации" as UC_GenAlgo
usecase "Расставить вход и выход" as UC_InOut
usecase "Выбрать способ расстановки" as UC_InOutMode
usecase "Расставить автоматически" as UC_InOutAuto
usecase "Расставить вручную" as UC_InOutManual
usecase "Задать вход" as UC_SetEntry
usecase "Задать выход" as UC_SetExit
usecase "Сохранить лабиринт" as UC_Save

' --- Игрок ---
usecase "Выбрать лабиринт из списка" as UC_Select
usecase "Пройти лабиринт" as UC_Play
usecase "Пройти вручную" as UC_Manual
usecase "Пройти автоматически" as UC_Auto
usecase "Выбрать алгоритм поиска пути" as UC_PathAlgo
usecase "Настроить скорость перемещения" as UC_Speed
usecase "Найти путь в лабиринте" as UC_FindPath
usecase "Отобразить следы прохождения" as UC_Trace

' === Связи ===

' Пользователь
User --> UC_InfoSys
User --> UC_InfoDev
User --> UC_Auth
User --> UC_Register

UC_Auth ..> UC_Login    : <<include>>
UC_Auth ..> UC_Password : <<include>>

UC_Register ..> UC_Login           : <<include>>
UC_Register ..> UC_Password        : <<include>>
UC_Register ..> UC_PasswordConfirm : <<include>>

' Администратор
Admin --> UC_Create
Admin --> UC_Save

UC_Create ..> UC_Name   : <<include>>
UC_Create ..> UC_Width  : <<include>>
UC_Create ..> UC_Height : <<include>>
UC_Theme   ..> UC_Create  : <<extend>>
UC_GenAlgo ..> UC_Create  : <<extend>>
UC_InOut   ..> UC_Create  : <<extend>>

UC_InOut ..> UC_InOutMode       : <<include>>
UC_InOutAuto   ..> UC_InOutMode : <<extend>>
UC_InOutManual ..> UC_InOutMode : <<extend>>

UC_InOutManual ..> UC_SetEntry : <<include>>
UC_InOutManual ..> UC_SetExit  : <<include>>

' Игрок
Player --> UC_Select
Player --> UC_Play

UC_Theme ..> UC_Select : <<extend>>

UC_Manual ..> UC_Play : <<extend>>
UC_Auto   ..> UC_Play : <<extend>>

UC_Auto ..> UC_PathAlgo : <<include>>
UC_Speed ..> UC_Auto    : <<extend>>
UC_Auto ..> UC_FindPath : <<include>>
UC_Auto ..> UC_Trace    : <<include>>

UC_Manual ..> UC_Trace : <<include>>

@enduml
