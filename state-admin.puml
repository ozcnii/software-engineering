@startuml
title Диаграмма состояний (Работа с приложением: Администратор)

skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
  ArrowColor #000000
  ArrowFontSize 11
  ArrowFontStyle italic
}
skinparam DefaultFontName Helvetica

[*] --> Ожидание

state "Ожидание действий\nадминистратора" as Ожидание

state "Просмотр списка\nлабиринтов" as СписокЛабиринтов {
  СписокЛабиринтов : entry / отобразить форму "Все лабиринты"
  СписокЛабиринтов : do / выполнить SQL-запрос на выборку
  СписокЛабиринтов : do / отобразить таблицу лабиринтов
  СписокЛабиринтов : do / ожидание действий со списком
  СписокЛабиринтов : ввод в поле "Поиск" / отфильтровать список
  СписокЛабиринтов : exit / закрыть форму списка
}

state "Удаление лабиринта" as УдалениеЛабиринта {
  УдалениеЛабиринта : entry / отобразить диалоговое окно\n           с подтверждением удаления
  УдалениеЛабиринта : do / ожидать действие пользователя
  УдалениеЛабиринта : exit / закрыть диалоговое окно
}

state "Создание лабиринта" as СозданиеЛабиринта {
  [*] --> ВводПараметров

  state "Шаг 1.\nВвод параметров" as ВводПараметров {
    ВводПараметров : entry / отобразить шаг "Параметры"
    ВводПараметров : do / ввести название
    ВводПараметров : do / ввести ширину и высоту
    ВводПараметров : do / выбрать тему оформления
    ВводПараметров : do / выбрать алгоритм генерации
    ВводПараметров : do / выбрать способ расстановки\n       входа и выхода
  }

  state "Шаг 2.\nРедактирование на холсте" as Редактор {
    Редактор : entry / сгенерировать лабиринт\n        выбранным алгоритмом
    Редактор : entry / отобразить шаг "Редактор"
    Редактор : do / редактировать ячейки\n      (стена / проход)
    Редактор : do / задать вход и выход\n      (если выбран ручной режим)
    Редактор : нажата кнопка "Перегенерировать" /\n     сгенерировать новый лабиринт\n     выбранным алгоритмом
  }

  state "Шаг 3.\nПодтверждение и сохранение" as Сохранение {
    Сохранение : entry / отобразить шаг "Сохранить"
    Сохранение : entry / отобразить итоговые параметры\n        и превью лабиринта
    Сохранение : do / ожидать подтверждение пользователя
    Сохранение : exit / закрыть форму создания
  }

  state ПроверкаДанных <<choice>>

  ВводПараметров --> ПроверкаДанных : нажата кнопка\n"Далее"
  ПроверкаДанных --> Редактор : [данные\nкорректны]
  ПроверкаДанных --> ВводПараметров : [данные\nнекорректны]

  Редактор --> ВводПараметров : нажата кнопка\n"Назад"
  Редактор --> Сохранение : нажата кнопка "Далее"\n[вход и выход\nзаданы]
  Сохранение --> Редактор : нажата кнопка\n"Назад"
  Сохранение --> [*] : нажата кнопка "Сохранить" /\nINSERT INTO Labyrinth
}

state "Просмотр сведений\nо разработчике" as Разработчик {
  Разработчик : entry / отобразить форму\n        "О разработчике"
  Разработчик : exit / закрыть форму
}

state "Просмотр сведений\nо системе" as Система {
  Система : entry / отобразить форму\n        "О системе"
  Система : exit / закрыть форму
}

' --- переходы из/в hub ---

Ожидание --> СписокЛабиринтов : выбран пункт меню\n"Все лабиринты"
СписокЛабиринтов --> Ожидание : [работа со списком\nзавершена]

СписокЛабиринтов --> УдалениеЛабиринта : нажата кнопка\n"Удалить"\n[выбран лабиринт]
УдалениеЛабиринта --> СписокЛабиринтов : нажата кнопка\n"Подтвердить" /\nDELETE FROM Labyrinth;\nобновить список
УдалениеЛабиринта --> СписокЛабиринтов : нажата кнопка\n"Отмена"

Ожидание --> СозданиеЛабиринта : выбран пункт меню\n"Создать новый"
СозданиеЛабиринта --> СписокЛабиринтов : [создание\nзавершено]
СозданиеЛабиринта --> СписокЛабиринтов : нажата кнопка\n"Отмена"

Ожидание --> Разработчик : выбран пункт меню\n"О разработчике"
Разработчик --> Ожидание : выбран другой\nпункт меню

Ожидание --> Система : выбран пункт меню\n"О системе"
Система --> Ожидание : выбран другой\nпункт меню

Ожидание --> [*] : нажата кнопка\n"Выйти"

@enduml
