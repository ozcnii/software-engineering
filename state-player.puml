@startuml
title Диаграмма состояний (Работа с приложением: Игрок)

skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 12
  ArrowColor #000000
  ArrowFontSize 11
  ArrowFontStyle italic
}
skinparam DefaultFontName Helvetica

[*] --> Ожидание

state "Ожидание действий\nигрока" as Ожидание {
  Ожидание : entry / отобразить экран игрока
  Ожидание : do / выполнить SQL-запрос на выборку лабиринтов
  Ожидание : do / отобразить список лабиринтов в левой панели
  Ожидание : do / ожидать выбор лабиринта или пункта меню
  Ожидание : смена темы оформления / перерисовать визуализацию\n     лабиринта (изменение локально для сессии)
  Ожидание : ввод в поле "Поиск" / отфильтровать список лабиринтов
}

state "Прохождение лабиринта" as Прохождение {
  Прохождение : entry / загрузить выбранный лабиринт
  Прохождение : entry / разместить игрока в точке входа (S)
  Прохождение : do / отображать текущее положение и статистику
  Прохождение : смена темы оформления / перерисовать визуализацию\n     (изменение локально для сессии)

  [*] --> РучноеУправление

  state "Ручное управление" as РучноеУправление {
    РучноеУправление : entry / активировать вкладку "Ручное"
    РучноеУправление : do / ожидать нажатие клавиши/кнопки d-pad
    РучноеУправление : нажата клавиша направления / сместить игрока\n          и отобразить след прохождения
    РучноеУправление : нажата кнопка "Сбросить" / вернуть игрока\n          на старт
  }

  state "Автоматическое решение" as АвтоРешение {
    АвтоРешение : entry / активировать вкладку "Авто-решение"
    АвтоРешение : do / выбрать алгоритм поиска пути (BFS / DFS)
    АвтоРешение : do / задать режим (с анимацией / мгновенно)
    АвтоРешение : do / задать скорость перемещения
    АвтоРешение : нажата кнопка "Запустить решение" /\n     найти путь и отобразить следы прохождения
    АвтоРешение : нажата кнопка "Сбросить" / вернуть игрока\n     на старт
  }

  РучноеУправление --> АвтоРешение : выбрана вкладка\n"Авто-решение"
  АвтоРешение --> РучноеУправление : выбрана вкладка\n"Ручное"
}

state "Просмотр сведений\nо разработчике" as Разработчик {
  Разработчик : entry / отобразить модальное окно\n        "О разработчике"
  Разработчик : exit / закрыть модальное окно
}

state "Просмотр сведений\nо системе" as Система {
  Система : entry / отобразить модальное окно\n        "О системе"
  Система : exit / закрыть модальное окно
}

Ожидание --> Прохождение : выбран лабиринт\nиз списка
Прохождение --> Ожидание : нажата кнопка\n"Выйти из уровня"
Прохождение --> Ожидание : [игрок достиг выхода (E)] /\nпоказать сообщение "Уровень пройден"

Ожидание --> Разработчик : нажата кнопка\n"О разработчике"
Разработчик --> Ожидание : нажата кнопка\n"Закрыть"

Ожидание --> Система : нажата кнопка\n"О системе"
Система --> Ожидание : нажата кнопка\n"Закрыть"

Ожидание --> [*] : нажата кнопка\n"Выйти"

@enduml
